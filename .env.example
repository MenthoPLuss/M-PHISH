APP_ENV=development
DATABASE_URL=sqlite:///backend/m_phish.db
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=true
EXTENSION_IDS=
CRAWLER_URL=
AI_PROVIDER=fallback
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
ML_ARTIFACT_PATH=
ML_ARTIFACT_SHA256=
ML_RESEARCH_RESULTS=
# Domain-name CNN (see docs/URL_CNN.md). Leave empty to disable.
ML_CNN_ARTIFACT_PATH=
ML_CNN_ARTIFACT_SHA256=
# true only for local testing of a model whose release gate failed; ignored in production
ML_CNN_ALLOW_UNGATED=false
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
